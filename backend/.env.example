# PDFToolConverter API | Phase 0 environment template.
# Copy to .env for local runs. Docker Compose supplies its own values.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Request limits (Phase 0 gate values, tools arrive later)
BODY_LIMIT_BYTES=27262976
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=20
REQUEST_TIMEOUT_MS=30000

# CORS: comma separated origins, or * for open
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Workspace roots (file lifecycle directories)
WORKSPACE_ROOT=/var/lib/pdftoolconverteronline
WORKSPACE_UPLOAD_TTL_MS=900000
WORKSPACE_OUTPUT_TTL_MS=3600000

# Redis (container is provisioned, no queue is wired in Phase 0)
REDIS_URL=redis://redis:6379

# Docs
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000
